        },
        "axis": {
          "x": {
            "title": {
              "visible": false
            },
            "scale": "temporal"
          },
          "y": {
            "title": {
              "visible": true
            }
          }
        },
        "styling": {
          "interpolation": "smooth",
          "areas": {
            "fill": "gradient",
            "fill_opacity": 0.7
