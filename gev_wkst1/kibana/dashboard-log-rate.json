          {
            "type": "area_stacked",
            "data_source": {
              "type": "esql",
              "query": "FROM logs-elasticco.*\n| WHERE @timestamp <= ?_tend AND @timestamp > ?_tstart AND labels.demo == \"elastic-co\"\n| STATS count = COUNT(*) BY bucket = BUCKET(@timestamp, 40, ?_tstart, ?_tend), service.name\n| SORT bucket"
            },
            "x": {
              "column": "bucket"
            },
            "y": [
              {
                "column": "count"
              }
            ],
            "breakdown_by": {
              "column": "service.name"
            }
          }
        ],
        "legend": {
          "visibility": "visible",
