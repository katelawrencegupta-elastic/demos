{
  "template": {
    "settings": {
      "index": {
        "default_pipeline": "logs-elasticco.orchestrator"
      }
    },
    "mappings": {
      "properties": {
        "tenant": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },
        "trace": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },
        "order": {
          "properties": {
            "id": { "type": "keyword" }
          }
        },
        "orchestrator": {
          "properties": {
            "dag_id": { "type": "keyword" },
            "task_id": { "type": "keyword" },
            "ts": { "type": "keyword" }
          }
        },
        "log": {
          "properties": {
            "level": { "type": "keyword" }
          }
        },
        "service": {
          "properties": {
            "name": { "type": "keyword" }
          }
        },
        "message": { "type": "match_only_text" },
        "event": {
          "properties": {
            "original": { "type": "keyword", "index": false, "doc_values": false }
          }
        },
        "labels": {
          "properties": {
            "demo": { "type": "keyword" }
          }
        }
      }
    }
  },
  "_meta": {
    "description": "Elastic Co. orchestrator log mappings + default pipeline",
    "demo": "elastic-co"
  }
}
