  {
    "name": "[Meridian] checkout-assistant daily LLM cost",
    "description": "Daily gen_ai span cost for checkout-assistant under ceiling. The llm_agent_loop scenario (−8..−6, ×12) burns this budget.",
    "indicator": {
      "type": "sli.metric.timeslice",
      "params": {
        "index": "traces-apm-default",
        "timestampField": "@timestamp",
        "metric": {
          "metrics": [
            {
              "name": "A",
              "aggregation": "sum",
              "field": "labels.llm_cost_usd"
            }
          ],
          "equation": "A",
          "comparator": "LTE",
          "threshold": 0.8
        },
        "filter": "span.subtype : \"gen_ai\" and service.name : \"checkout-assistant\""
      }
    },
    "budgetingMethod": "timeslices",
    "timeWindow": {
      "duration": "30d",
      "type": "rolling"
    },
    "objective": {
      "target": 0.95,
      "timesliceTarget": 0.95,
      "timesliceWindow": "24h"
    },
    "tags": [
      "meridian",
      "finops",
      "workshop"
    ],
    "id": "meridian-slo-llm-checkout-spend",
    "settings": {
      "preventInitialBackfill": false,
