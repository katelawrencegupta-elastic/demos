{
  "id": "fleet-default-elastic_agent-elastic-agent-high-pipeline-queue",
  "enabled": false,
  "name": "[Elastic Agent] High pipeline queue",
  "tags": [
    "Elastic Agent",
    "Pipeline and Queues"
  ],
  "rule_type_id": ".es-query",
  "consumer": "alerts",
  "schedule": {
    "interval": "1m"
  },
  "actions": [],
  "params": {
    "searchType": "esqlQuery",
    "timeWindowSize": 1,
    "timeWindowUnit": "m",
    "threshold": [
      0
    ],
    "thresholdComparator": ">",
    "size": 100,
    "esqlQuery": {
      "esql": "FROM metrics-elastic_agent.*beat-*\n| WHERE data_stream.dataset LIKE \"elastic_agent.*beat\" AND agent.name NOT LIKE \"*agentless*\"\n| STATS pipeline_queue_pct = MAX(beat.stats.libbeat.pipeline.queue.filled.pct) * 100 BY elastic_agent.id, component.id\n| WHERE pipeline_queue_pct >= 90"
    },
    "aggType": "count",
    "groupBy": "row",
    "termSize": 5,
    "sourceFields": [],
    "timeField": "@timestamp",
    "excludeHitsFromPreviousRun": true
  },
