        "config": {
          "type": "metric",
          "title": "",
          "description": "The total API requests blocked due to content filtering. The content filtering blocks requests when it finds harmful content either in the prompt or in the response text.",
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "data_view_reference",
            "ref_id": "logs-*"
          },
          "styling": {
            "density": "compact",
            "primary": {
              "position": "bottom",
              "labels": {
                "alignment": "left"
              },
              "value": {
                "alignment": "right",
                "sizing": "auto"
              }
            }
          },
          "metrics": [
            {
              "format": {
                "type": "number",
                "decimals": 0,
                "compact": true
              },
              "label": "Total content filtering API requests",
              "filter": {
                "language": "kql",
                "expression": "azure.open_ai.properties.backend_response_body.choices.finish_reason : \"content_filter\" or azure.open_ai.properties.backend_response_body.error.code : \"content_filter\" "
              },
              "empty_as_null": true,
              "operation": "count",
              "type": "primary",
              "color": {
                "type": "static",
                "color": "#D6BF57"
              }
            }
          ]
        },
