        "config": {
          "type": "metric",
          "title": "[Elastic Agent] Average Processing Time",
          "filters": [
            {
              "disabled": false,
              "data_view_id": "97d460a6-1ab7-4031-a34d-4a8c2de02032",
              "type": "condition",
              "condition": {
                "field": "filebeat_input.input",
                "operator": "is",
                "value": "filestream"
              }
            }
          ],
          "sampling": 1,
          "ignore_global_filters": false,
          "data_source": {
            "type": "data_view_reference",
            "ref_id": "metrics-*"
          },
          "styling": {
            "density": "compact",
            "primary": {
              "position": "bottom",
              "labels": {
                "alignment": "left"
              },
              "value": {
                "alignment": "right",
                "sizing": "auto"
              }
            }
          },
          "metrics": [
            {
              "format": {
                "type": "number",
                "decimals": 2,
                "compact": true
              },
              "label": "Average Processing Time (Milliseconds)",
              "operation": "formula",
              "formula": "divide(last_value(filebeat_input.processing_time.histogram.mean), 1000000)",
              "type": "primary",
              "subtitle": "Since last restart",
              "color": {
