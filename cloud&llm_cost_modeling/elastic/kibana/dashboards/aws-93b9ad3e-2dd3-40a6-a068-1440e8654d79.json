          "description": "",
          "title": "Certificate Expired or Expiring in 30 days",
          "tabs": [
            {
              "column_order": [
                "aws.elb.listener",
                "aws.elb.ssl_protocol",
                "aws.elb.leaf_client_cert_serial_number",
                "aws.elb.leaf_client_cert_subject",
                "aws.elb.leaf_client_cert_not_after"
              ],
              "sort": [
                {
                  "name": "@timestamp",
                  "direction": "desc"
                }
              ],
              "data_source": {
                "type": "esql",
                "query": "FROM logs-*\n| WHERE data_stream.dataset == \"aws.elb_logs\"\n| where aws.elb.leaf_client_cert_not_after < now() - 30days\n| limit 10000\n| stats COUNT_DISTINCT(aws.elb.leaf_client_cert_serial_number) by aws.elb.listener, aws.elb.ssl_protocol, aws.elb.leaf_client_cert_serial_number, aws.elb.leaf_client_cert_subject, aws.elb.leaf_client_cert_not_after\n| keep aws.elb.listener, aws.elb.ssl_protocol, aws.elb.leaf_client_cert_serial_number, aws.elb.leaf_client_cert_subject, aws.elb.leaf_client_cert_not_after\n| sort aws.elb.leaf_client_cert_not_after asc"
              }
            }
          ]
        },
