[
  {
    "id": "fleet-default-elastic_agent-elastic-agent-excessive-restarts",
    "enabled": false,
    "name": "[Elastic Agent] Excessive restarts",
    "tags": [
      "Elastic Agent"
    ],
    "rule_type_id": ".es-query",
    "consumer": "alerts",
    "schedule": {
      "interval": "1m"
    },
    "actions": [],
    "params": {
      "searchType": "esqlQuery",
      "timeWindowSize": 5,
      "timeWindowUnit": "m",
      "threshold": [
        0
      ],
      "thresholdComparator": ">",
      "size": 100,
      "esqlQuery": {
        "esql": "FROM logs-elastic_agent-*\n| WHERE message like \"Starting*elastic-agent*\"\n| STATS restart_count = count(*) BY host.name, bucket(@timestamp,5 minute)\n| WHERE restart_count > 10\n| STATS MAX(restart_count) BY host.name"
      },
      "aggType": "count",
      "groupBy": "row",
      "termSize": 5,
      "sourceFields": [],
      "timeField": "@timestamp",
      "excludeHitsFromPreviousRun": true
    },
    "created_by": "719348788",
    "updated_by": "719348788",
    "created_at": "2026-08-12T18:16:35.004Z",
    "updated_at": "2026-08-12T18:16:35.004Z",
    "api_key_owner": null,
    "api_key_created_by_user": null,
    "throttle": null,
    "mute_all": false,
    "notify_when": null,
    "muted_alert_ids": [],
    "execution_status": {
