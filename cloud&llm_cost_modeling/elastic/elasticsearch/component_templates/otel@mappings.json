{
  "name": "otel@mappings",
  "component_template": {
    "template": {
      "mappings": {
        "dynamic": false,
        "dynamic_templates": [
          {
            "complex_attributes": {
              "path_match": [
                "resource.attributes.*",
                "scope.attributes.*",
                "attributes.*"
              ],
              "path_unmatch": [
                "*.geo.location"
              ],
              "mapping": {
                "type": "flattened"
              },
              "match_mapping_type": "object"
            }
          }
        ],
        "date_detection": false,
        "properties": {
          "@timestamp": {
            "type": "date"
          },
          "dropped_attributes_count": {
            "type": "long"
          },
          "resource": {
            "properties": {
              "dropped_attributes_count": {
                "type": "long"
              },
              "schema_url": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "attributes": {
                "dynamic": true,
                "time_series_dimension": true,
                "type": "passthrough",
                "priority": 40
              }
            }
          },
          "data_stream.namespace": {
            "type": "constant_keyword"
          },
          "data_stream.dataset": {
            "type": "constant_keyword"
          },
          "scope": {
            "properties": {
              "dropped_attributes_count": {
                "type": "long"
              },
              "name": {
                "ignore_above": 1024,
                "time_series_dimension": true,
                "type": "keyword"
              },
              "schema_url": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "attributes": {
                "dynamic": true,
                "time_series_dimension": true,
                "type": "passthrough",
                "priority": 30
              },
              "version": {
                "type": "version"
              }
            }
          },
          "attributes": {
            "dynamic": true,
            "time_series_dimension": true,
            "type": "passthrough",
            "priority": 20
          },
          "data_stream.type": {
            "type": "constant_keyword"
          },
          "event.dataset": {
            "path": "data_stream.dataset",
            "type": "alias"
          }
        }
      }
    },
    "version": 20,
    "_meta": {
      "description": "Default mappings for all OpenTelemetry data streams",
      "managed": true
    }
  }
}
