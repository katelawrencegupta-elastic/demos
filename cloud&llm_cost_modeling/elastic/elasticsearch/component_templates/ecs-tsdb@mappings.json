{
  "name": "ecs-tsdb@mappings",
  "component_template": {
    "template": {
      "mappings": {
        "dynamic_templates": [
          {
            "ecs_ip": {
              "path_match": [
                "ip",
                "*.ip",
                "*_ip"
              ],
              "mapping": {
                "type": "ip"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "all_strings_to_keywords": {
              "mapping": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          }
        ]
      }
    },
    "version": 20,
    "_meta": {
      "description": "Default mappings that can be changed by users for\nthe OpenTelemetry metrics index template installed by x-pack\n",
      "managed": true
    }
  }
}
