                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "gcp"
              },
              "dataset": {
                "type": "constant_keyword",
                "value": "gcp.cloudrun_metrics"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "gcp"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
