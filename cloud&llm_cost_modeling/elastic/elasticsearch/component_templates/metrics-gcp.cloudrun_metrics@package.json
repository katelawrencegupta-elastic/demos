{
  "name": "metrics-gcp.cloudrun_metrics@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-gcp.cloudrun_metrics-2.50.2",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "gcp.cloudrun_metrics.container.cpu.utilizations": {
              "path_match": "gcp.cloudrun_metrics.container.cpu.utilizations.*",
              "mapping": {
                "type": "histogram"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.cloudrun_metrics.container.max_request_concurrencies": {
              "path_match": "gcp.cloudrun_metrics.container.max_request_concurrencies.*",
              "mapping": {
                "type": "histogram"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.cloudrun_metrics.container.memory.utilizations": {
              "path_match": "gcp.cloudrun_metrics.container.memory.utilizations.*",
              "mapping": {
                "type": "histogram"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.cloudrun_metrics.request_latencies": {
              "path_match": "gcp.cloudrun_metrics.request_latencies.*",
              "mapping": {
                "type": "histogram"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.labels.user.*": {
              "path_match": "gcp.labels.user.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metadata.*": {
              "path_match": "gcp.labels.metadata.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metrics.*": {
              "path_match": "gcp.labels.metrics.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.system.*": {
              "path_match": "gcp.labels.system.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.resource.*": {
              "path_match": "gcp.labels.resource.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.metrics.*.*.*.*": {
              "path_match": "gcp.metrics.*.*.*.*",
              "mapping": {
                "type": "double"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.metrics.*.*.*": {
              "path_match": "gcp.metrics.*.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*.*": {
              "path_match": "gcp.metrics.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*": {
              "path_match": "gcp.metrics.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          }
        ],
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "gcp": {
            "properties": {
              "labels_fingerprint": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "cloudrun_metrics": {
                "dynamic": true,
                "type": "object",
                "properties": {
                  "container": {
                    "dynamic": true,
                    "type": "object",
                    "properties": {
                      "instance": {
                        "properties": {
                          "count": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "memory": {
                        "dynamic": true,
                        "type": "object",
                        "properties": {
                          "allocation_time": {
                            "time_series_metric": "gauge",
