                                  "unit": "byte"
                                },
                                "type": "long"
                              }
                            }
                          },
                          "sent": {
                            "properties": {
                              "bytes": {
                                "time_series_metric": "gauge",
                                "meta": {
                                  "unit": "byte"
                                },
                                "type": "long"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "request": {
                    "properties": {
                      "count": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  },
                  "request_latencies": {
                    "dynamic": true,
                    "type": "object"
                  }
                }
              },
              "metrics": {
                "dynamic": true,
                "type": "object"
              },
              "labels": {
                "dynamic": true,
                "type": "object",
                "properties": {
                  "metadata": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "system": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "resource": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "metrics": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "user": {
                    "dynamic": true,
                    "type": "object"
                  }
                }
