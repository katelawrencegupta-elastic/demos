{
  "name": "metrics-aws.s3_request@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-aws.s3_request-7.1.1",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "region": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "aws"
              }
            }
          },
          "aws": {
            "properties": {
              "s3": {
                "properties": {
                  "bucket": {
                    "properties": {
                      "name": {
                        "time_series_dimension": true,
                        "type": "keyword"
                      }
                    }
                  }
                }
              },
              "metrics_names_fingerprint": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "cloudwatch": {
                "properties": {
                  "namespace": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "s3_request": {
                "properties": {
                  "latency": {
                    "properties": {
                      "total_request": {
                        "properties": {
                          "ms": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "first_byte": {
                        "properties": {
                          "ms": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  },
                  "uploaded": {
                    "properties": {
                      "bytes_per_period": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "bytes": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  },
                  "requests": {
                    "properties": {
                      "head": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "total": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "select_scanned": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "select": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "post": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "get": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "list": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "delete": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "select_returned": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "put": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  },
                  "downloaded": {
                    "properties": {
                      "bytes_per_period": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "bytes": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  },
                  "errors": {
                    "properties": {
                      "4xx": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "5xx": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  }
                }
              },
              "dimensions": {
                "properties": {
                  "BucketName": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "StorageType": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "FilterId": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              },
              "tags": {
                "type": "flattened"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "aws"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
