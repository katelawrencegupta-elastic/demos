{
  "name": "metrics-aws.ec2_metrics@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-aws.ec2_metrics-7.1.1",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "region": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "aws"
              }
            }
          },
          "aws": {
            "properties": {
              "ec2": {
                "properties": {
                  "instance": {
                    "properties": {
                      "core": {
                        "properties": {
                          "count": {
                            "type": "long"
                          }
                        }
                      },
                      "image": {
                        "properties": {
                          "id": {
                            "ignore_above": 1024,
                            "type": "keyword"
                          }
                        }
                      },
                      "private": {
                        "properties": {
                          "ip": {
                            "type": "ip"
                          },
                          "dns_name": {
                            "ignore_above": 1024,
                            "type": "keyword"
                          }
                        }
                      },
                      "threads_per_core": {
                        "type": "long"
                      },
                      "public": {
                        "properties": {
                          "ip": {
                            "type": "ip"
                          },
                          "dns_name": {
                            "ignore_above": 1024,
                            "type": "keyword"
                          }
                        }
                      },
                      "state": {
                        "properties": {
                          "code": {
                            "type": "long"
                          },
                          "name": {
                            "ignore_above": 1024,
                            "type": "keyword"
                          }
                        }
                      },
                      "monitoring": {
                        "properties": {
                          "state": {
                            "ignore_above": 1024,
                            "type": "keyword"
                          }
                        }
                      }
                    }
                  },
                  "metrics": {
                    "properties": {
                      "StatusCheckFailed_Instance": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "CPUCreditUsage": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "NetworkPacketsOut": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "DiskReadOps": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "StatusCheckFailed": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "CPUSurplusCreditsCharged": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "CPUSurplusCreditBalance": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "DiskReadBytes": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "StatusCheckFailed_System": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "NetworkOut": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "DiskWriteOps": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "CPUUtilization": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "CPUCreditBalance": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "DiskWriteBytes": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "NetworkPacketsIn": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "NetworkIn": {
                        "properties": {
                          "rate": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "metrics_names_fingerprint": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "cloudwatch": {
                "properties": {
                  "namespace": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "dimensions": {
                "properties": {
                  "InstanceId": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "AutoScalingGroupName": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "ImageId": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "InstanceType": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              },
              "tags": {
                "type": "flattened"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "aws"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
