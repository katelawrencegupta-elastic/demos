{
  "name": "metrics-aws.rds@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-aws.rds-7.1.1",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "aws.rds.metrics.*.*": {
              "path_match": "aws.rds.metrics.*.*",
              "mapping": {
                "type": "double"
              },
              "match_mapping_type": "double"
            }
          },
          {
            "aws.rds.metrics.*": {
              "path_match": "aws.rds.metrics.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          }
        ],
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "region": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "aws"
              }
            }
          },
          "aws": {
            "properties": {
              "rds": {
                "properties": {
                  "transaction_logs_generation": {
                    "time_series_metric": "gauge",
                    "meta": {},
                    "type": "long"
                  },
                  "aurora_replica": {
                    "properties": {
                      "lag": {
                        "properties": {
                          "ms": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "lag_max": {
                        "properties": {
                          "ms": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "lag_min": {
                        "properties": {
                          "ms": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  },
                  "latency": {
                    "properties": {
                      "dml": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "read": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "select": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "commit": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "insert": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "update": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "ddl": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "write": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "delete": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      }
                    }
                  },
                  "read_io": {
                    "properties": {
                      "ops_per_sec": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      }
                    }
                  },
                  "rds_to_aurora_postgresql_replica_lag": {
                    "properties": {
                      "sec": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  },
                  "backup_storage_billed_total": {
                    "properties": {
                      "bytes": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  },
                  "database_connections": {
                    "time_series_metric": "gauge",
                    "meta": {},
                    "type": "long"
                  },
                  "maximum_used_transaction_ids": {
                    "time_series_metric": "counter",
                    "meta": {},
                    "type": "long"
                  },
                  "db_instance": {
                    "properties": {
                      "identifier": {
                        "time_series_dimension": true,
                        "type": "keyword"
                      },
                      "role": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      },
                      "engine_name": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      },
                      "arn": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      },
                      "class": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      },
                      "db_cluster_identifier": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      },
                      "status": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      }
                    }
                  },
                  "failed_sql_server_agent_jobs": {
                    "time_series_metric": "gauge",
                    "meta": {},
                    "type": "long"
                  },
                  "disk_usage": {
                    "properties": {
                      "transaction_logs": {
                        "properties": {
                          "mb": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "bin_log": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "replication_slot": {
                        "properties": {
                          "mb": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  },
                  "login_failures": {
                    "time_series_metric": "gauge",
