                        "type": "float"
                      },
                      "insert": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "update": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "delete": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "ddl": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "write": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      },
                      "network": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "float"
                      }
                    }
                  },
                  "deadlocks": {
                    "time_series_metric": "gauge",
                    "meta": {},
                    "type": "long"
                  },
                  "volume_used": {
                    "properties": {
                      "bytes": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      }
                    }
                  },
                  "backtrack_change_records": {
                    "properties": {
                      "stored": {
                        "time_series_metric": "gauge",
                        "meta": {},
                        "type": "long"
                      },
                      "creation_rate": {
                        "time_series_metric": "gauge",
