              },
              "results": {
                "properties": {
                  "items": {
                    "type": "object",
                    "enabled": false
                  },
                  "total_results": {
                    "type": "integer"
                  }
                }
              },
              "search_application": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
