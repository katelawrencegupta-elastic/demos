{
  "name": "metrics-gcp.cloudsql_postgresql@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-gcp.cloudsql_postgresql-2.50.2",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "gcp.labels.user.*": {
              "path_match": "gcp.labels.user.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metadata.*": {
              "path_match": "gcp.labels.metadata.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metrics.*": {
              "path_match": "gcp.labels.metrics.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.system.*": {
              "path_match": "gcp.labels.system.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.resource.*": {
              "path_match": "gcp.labels.resource.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.metrics.*.*.*.*": {
              "path_match": "gcp.metrics.*.*.*.*",
              "mapping": {
                "type": "double"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.metrics.*.*.*": {
              "path_match": "gcp.metrics.*.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*.*": {
              "path_match": "gcp.metrics.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*": {
              "path_match": "gcp.metrics.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          }
        ],
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
