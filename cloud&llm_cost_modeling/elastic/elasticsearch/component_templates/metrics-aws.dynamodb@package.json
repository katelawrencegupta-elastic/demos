{
  "name": "metrics-aws.dynamodb@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-aws.dynamodb-7.1.1",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "region": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "aws"
              }
            }
          },
          "aws": {
            "properties": {
              "metrics_names_fingerprint": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "cloudwatch": {
                "properties": {
                  "namespace": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "dynamodb": {
                "properties": {
                  "metrics": {
                    "properties": {
                      "ReplicationLatency": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "MaxProvisionedTableReadCapacityUtilization": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ConsumedReadCapacityUnits": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "AccountMaxTableLevelReads": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "WriteThrottleEvents": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "ProvisionedWriteCapacityUnits": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ThrottledRequests": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "AccountProvisionedReadCapacityUtilization": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ConditionalCheckFailedRequests": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "AccountProvisionedWriteCapacityUtilization": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ProvisionedReadCapacityUnits": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "TransactionConflict": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "MaxProvisionedTableWriteCapacityUtilization": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "SystemErrors": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "ReadThrottleEvents": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "SuccessfulRequestLatency": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "AccountMaxReads": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "PendingReplicationCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "ConsumedWriteCapacityUnits": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "AccountMaxWrites": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "OnlineIndexPercentageProgress": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "AccountMaxTableLevelWrites": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "dimensions": {
                "properties": {
                  "TableName": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "StreamLabel": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "GlobalSecondaryIndexName": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "Verb": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "ReceivingRegion": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "Operation": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "OperationType": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "DelegatedOperation": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              },
              "tags": {
                "type": "flattened"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "aws"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
