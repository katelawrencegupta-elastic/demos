{
  "name": "metrics-azure.billing@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-azure.billing-1.12.0",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            }
          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "azure.metrics.*.*": {
              "path_match": "azure.metrics.*.*",
              "mapping": {
                "type": "float"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "azure.metrics.*": {
              "path_match": "azure.metrics.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          }
        ],
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "dataset": {
            "properties": {
              "name": {
                "type": "constant_keyword"
              },
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              }
            }
          },
          "azure": {
            "properties": {
              "subscription_id": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "timegrain": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "resource": {
                "properties": {
                  "name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "type": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "group": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "tags": {
                    "type": "flattened"
                  }
                }
              },
              "namespace": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "metrics": {
                "dynamic": true,
                "type": "object"
              },
              "application_id": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "billing": {
                "properties": {
                  "pretax_cost": {
                    "type": "float"
                  },
                  "product": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "usage_start": {
                    "type": "date"
                  },
                  "usage_end": {
                    "type": "date"
                  },
                  "actual_cost": {
                    "type": "float"
                  },
                  "department_name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "account_name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "usage_date": {
                    "type": "date"
                  },
                  "currency": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "forecast_cost": {
                    "type": "float"
                  },
                  "billing_period_id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "dimensions": {
                "type": "flattened"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "azure_billing"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
