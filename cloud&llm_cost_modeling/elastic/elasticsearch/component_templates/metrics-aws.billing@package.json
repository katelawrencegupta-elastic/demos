{
  "name": "metrics-aws.billing@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-aws.billing-7.1.1",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            }
          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "aws.billing.group_by": {
              "path_match": "aws.billing.group_by.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "*"
            }
          }
        ],
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "account": {
                "properties": {
                  "id": {
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "aws"
              }
            }
          },
          "aws": {
            "properties": {
              "linked_account": {
                "properties": {
                  "name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "cloudwatch": {
                "properties": {
                  "namespace": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "billing": {
                "dynamic": true,
                "type": "object",
                "properties": {
                  "end_date": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "BlendedCost": {
                    "properties": {
                      "amount": {
                        "meta": {},
                        "type": "double"
                      },
                      "unit": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      }
                    }
                  },
                  "group_definition": {
                    "properties": {
                      "type": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      },
                      "key": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      }
                    }
                  },
                  "AmortizedCost": {
                    "properties": {
                      "amount": {
                        "meta": {},
                        "type": "double"
                      },
                      "unit": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      }
                    }
                  },
                  "ServiceName": {
                    "type": "keyword"
                  },
                  "Currency": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "NormalizedUsageAmount": {
                    "properties": {
                      "amount": {
                        "meta": {},
                        "type": "double"
                      },
                      "unit": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      }
                    }
                  },
                  "UsageQuantity": {
                    "properties": {
                      "amount": {
                        "meta": {},
                        "type": "double"
                      },
                      "unit": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      }
                    }
                  },
                  "group_by": {
                    "dynamic": true,
                    "type": "object",
                    "properties": {
                      "fingerprint": {
                        "type": "keyword"
                      }
                    }
                  },
                  "UnblendedCost": {
                    "properties": {
                      "amount": {
                        "meta": {},
                        "type": "double"
                      },
                      "unit": {
                        "ignore_above": 1024,
                        "type": "keyword"
                      }
                    }
                  },
                  "EstimatedCharges": {
                    "meta": {},
                    "type": "long"
                  },
                  "start_date": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "tags": {
                "type": "flattened"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "aws"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
