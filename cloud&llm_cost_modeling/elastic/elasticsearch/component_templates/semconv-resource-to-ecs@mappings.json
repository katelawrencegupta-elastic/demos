                "dynamic": true,
                "time_series_dimension": true,
                "type": "passthrough",
                "priority": 40,
                "properties": {
                  "k8s.container.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.namespace.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.cluster.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.cronjob.name": {
                    "ignore_above": 1024,
