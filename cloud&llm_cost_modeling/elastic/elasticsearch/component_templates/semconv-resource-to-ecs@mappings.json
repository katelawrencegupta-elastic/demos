                  },
                  "k8s.pod.uid": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.statefulset.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "process.runtime.version": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "os.type": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "os.version": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "telemetry.sdk.language": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "process.runtime.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "service.instance.id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.pod.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "os.description": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "host.arch": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.deployment.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "os.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "host.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.node.uid": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "cloud.platform": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.daemonset.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "deployment.environment": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.replicaset.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.job.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.node.name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "k8s.node.hostname": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "process.executable.path": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "container.image.tags": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "kubernetes.replicaset.name": {
            "path": "resource.attributes.k8s.replicaset.name",
            "type": "alias"
          },
          "service.runtime.name": {
            "path": "resource.attributes.process.runtime.name",
            "type": "alias"
          },
          "kubernetes.cronjob.name": {
            "path": "resource.attributes.k8s.cronjob.name",
            "type": "alias"
          },
          "service.runtime.version": {
            "path": "resource.attributes.process.runtime.version",
