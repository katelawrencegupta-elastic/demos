{
  "name": "metrics-aws.lambda@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-aws.lambda-7.1.1",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "region": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "aws"
              }
            }
          },
          "aws": {
            "properties": {
              "lambda": {
                "properties": {
                  "metrics": {
                    "properties": {
                      "FilteredOutEventCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "OnFailureDestinationDeliveredEventCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "UnreservedConcurrentExecutions": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "Duration": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ProvisionedConcurrencyUtilization": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "ProvisionedConcurrencyInvocations": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "InvokedEventCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "FailedInvokeEventCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "Errors": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "IteratorAge": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ConcurrentExecutions": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ProvisionedConcurrencySpilloverInvocations": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "Invocations": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "DeadLetterErrors": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "ProvisionedConcurrentExecutions": {
                        "properties": {
                          "max": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "DeletedEventCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "DestinationDeliveryFailures": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "AsyncEventsReceived": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "DroppedEventCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "AsyncEventAge": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {
                              "unit": "ms"
                            },
                            "type": "long"
                          }
                        }
                      },
                      "Throttles": {
                        "properties": {
                          "avg": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          },
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      },
                      "PolledEventCount": {
                        "properties": {
                          "sum": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "double"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "metrics_names_fingerprint": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "cloudwatch": {
                "properties": {
                  "namespace": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "dimensions": {
                "properties": {
                  "FunctionName": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "ExecutedVersion": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "Resource": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  },
                  "EventSourceMappingUUID": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              },
              "tags": {
                "type": "flattened"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "aws"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
