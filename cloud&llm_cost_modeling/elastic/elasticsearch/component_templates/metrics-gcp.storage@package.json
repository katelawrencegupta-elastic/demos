{
  "name": "metrics-gcp.storage@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-gcp.storage-2.50.2",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "gcp.labels.user.*": {
              "path_match": "gcp.labels.user.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metadata.*": {
              "path_match": "gcp.labels.metadata.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metrics.*": {
              "path_match": "gcp.labels.metrics.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.system.*": {
              "path_match": "gcp.labels.system.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.resource.*": {
              "path_match": "gcp.labels.resource.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.metrics.*.*.*.*": {
              "path_match": "gcp.metrics.*.*.*.*",
              "mapping": {
                "type": "double"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.metrics.*.*.*": {
              "path_match": "gcp.metrics.*.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*.*": {
              "path_match": "gcp.metrics.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*": {
              "path_match": "gcp.metrics.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          }
        ],
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "gcp": {
            "properties": {
              "labels_fingerprint": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "storage": {
                "properties": {
                  "api": {
                    "properties": {
                      "request": {
                        "properties": {
                          "count": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  },
                  "storage": {
                    "properties": {
                      "total": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "total_byte_seconds": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "object": {
                        "properties": {
                          "count": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  },
                  "authz": {
                    "properties": {
                      "object_specific_acl_mutation": {
                        "properties": {
                          "count": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "acl_operations": {
                        "properties": {
                          "count": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "acl_based_object_access": {
                        "properties": {
                          "count": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  },
                  "network": {
                    "properties": {
                      "received": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "sent": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "metrics": {
                "dynamic": true,
                "type": "object"
              },
              "labels": {
                "dynamic": true,
                "type": "object",
                "properties": {
                  "metadata": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "system": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "resource": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "metrics": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "user": {
                    "dynamic": true,
                    "type": "object"
                  }
                }
              }
            }
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "gcp"
              },
              "dataset": {
                "type": "constant_keyword",
                "value": "gcp.storage"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "gcp"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
