{
  "name": "logs-elastic_agent.filebeat_input@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "logs-elastic_agent.filebeat_input-2.9.4",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            }
          }
        }
      },
      "mappings": {
        "dynamic": true,
        "properties": {
          "component": {
            "properties": {
              "binary": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "id": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "type": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "dataset": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "error": {
            "properties": {
              "code": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "id": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "message": {
                "type": "match_only_text"
              }
            }
          },
          "filebeat_input": {
            "properties": {
              "input": {
                "ignore_above": 1024,
                "type": "keyword"
              },
              "id": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "elastic_agent"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
