          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "gcp.labels.user.*": {
              "path_match": "gcp.labels.user.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metadata.*": {
              "path_match": "gcp.labels.metadata.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metrics.*": {
              "path_match": "gcp.labels.metrics.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.system.*": {
              "path_match": "gcp.labels.system.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.resource.*": {
              "path_match": "gcp.labels.resource.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
