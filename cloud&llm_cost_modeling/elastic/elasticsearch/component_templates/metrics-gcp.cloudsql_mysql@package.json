                "type": "double"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.metrics.*.*.*": {
              "path_match": "gcp.metrics.*.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*.*": {
              "path_match": "gcp.metrics.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*": {
              "path_match": "gcp.metrics.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          }
