{
  "name": "logs-gcp.dns@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "logs-gcp.dns-2.50.2",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            }
          }
        }
      },
      "mappings": {
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "input": {
            "properties": {
              "type": {
                "ignore_above": 1024,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "log": {
            "properties": {
              "offset": {
                "type": "long"
              }
            }
          },
          "gcp": {
            "properties": {
              "dns": {
                "properties": {
                  "flattened": {
                    "type": "flattened"
                  },
                  "vm_instance_name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "vm_zone_name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "response_code": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "target_type": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "rdata": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "source_type": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "query_type": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "source_ip": {
                    "type": "ip"
                  },
                  "protocol": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "vm_project_id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "destination_ip": {
                    "type": "ip"
                  },
                  "query_name": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "server_latency": {
                    "type": "long"
                  },
                  "auth_answer": {
                    "type": "boolean"
                  },
                  "vm_instance_id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "source_network": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "egress_error": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "gcp"
              },
              "dataset": {
                "type": "constant_keyword",
                "value": "gcp.dns"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "gcp"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
