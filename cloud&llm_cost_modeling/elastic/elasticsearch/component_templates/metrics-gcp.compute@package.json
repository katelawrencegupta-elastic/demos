{
  "name": "metrics-gcp.compute@package",
  "component_template": {
    "template": {
      "settings": {
        "index": {
          "default_pipeline": "metrics-gcp.compute-2.50.2",
          "mapping": {
            "total_fields": {
              "limit": "1000"
            },
            "source": {
              "mode": "synthetic"
            }
          }
        }
      },
      "mappings": {
        "dynamic_templates": [
          {
            "gcp.labels.user.*": {
              "path_match": "gcp.labels.user.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metadata.*": {
              "path_match": "gcp.labels.metadata.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.metrics.*": {
              "path_match": "gcp.labels.metrics.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.system.*": {
              "path_match": "gcp.labels.system.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.labels.resource.*": {
              "path_match": "gcp.labels.resource.*",
              "mapping": {
                "type": "keyword"
              },
              "match_mapping_type": "string"
            }
          },
          {
            "gcp.metrics.*.*.*.*": {
              "path_match": "gcp.metrics.*.*.*.*",
              "mapping": {
                "type": "double"
              },
              "match_mapping_type": "*"
            }
          },
          {
            "gcp.metrics.*.*.*": {
              "path_match": "gcp.metrics.*.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*.*": {
              "path_match": "gcp.metrics.*.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          },
          {
            "gcp.metrics.*": {
              "path_match": "gcp.metrics.*",
              "mapping": {
                "dynamic": true,
                "type": "object"
              },
              "match_mapping_type": "object"
            }
          }
        ],
        "properties": {
          "cloud": {
            "properties": {
              "image": {
                "properties": {
                  "id": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "availability_zone": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "instance": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              },
              "machine": {
                "properties": {
                  "type": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              },
              "region": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "account": {
                "properties": {
                  "id": {
                    "time_series_dimension": true,
                    "type": "keyword"
                  }
                }
              }
            }
          },
          "agent": {
            "properties": {
              "id": {
                "time_series_dimension": true,
                "type": "keyword"
              }
            }
          },
          "@timestamp": {
            "ignore_malformed": false,
            "type": "date"
          },
          "gcp": {
            "properties": {
              "compute": {
                "properties": {
                  "instance": {
                    "properties": {
                      "disk": {
                        "properties": {
                          "read_ops_count": {
                            "properties": {
                              "value": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "long"
                              }
                            }
                          },
                          "read": {
                            "properties": {
                              "bytes": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "long"
                              }
                            }
                          },
                          "write_ops_count": {
                            "properties": {
                              "value": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "long"
                              }
                            }
                          },
                          "write": {
                            "properties": {
                              "bytes": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "long"
                              }
                            }
                          }
                        }
                      },
                      "memory": {
                        "properties": {
                          "balloon": {
                            "properties": {
                              "ram_size": {
                                "properties": {
                                  "value": {
                                    "time_series_metric": "gauge",
                                    "meta": {},
                                    "type": "long"
                                  }
                                }
                              },
                              "swap_in": {
                                "properties": {
                                  "bytes": {
                                    "time_series_metric": "gauge",
                                    "meta": {},
                                    "type": "long"
                                  }
                                }
                              },
                              "ram_used": {
                                "properties": {
                                  "value": {
                                    "time_series_metric": "gauge",
                                    "meta": {},
                                    "type": "long"
                                  }
                                }
                              },
                              "swap_out": {
                                "properties": {
                                  "bytes": {
                                    "time_series_metric": "gauge",
                                    "meta": {},
                                    "type": "long"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "cpu": {
                        "properties": {
                          "usage_time": {
                            "properties": {
                              "sec": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "double"
                              }
                            }
                          },
                          "usage": {
                            "properties": {
                              "pct": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "double"
                              }
                            }
                          },
                          "reserved_cores": {
                            "properties": {
                              "value": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "double"
                              }
                            }
                          }
                        }
                      },
                      "uptime_total": {
                        "properties": {
                          "sec": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "network": {
                        "properties": {
                          "ingress": {
                            "properties": {
                              "bytes": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "long"
                              },
                              "packets": {
                                "properties": {
                                  "count": {
                                    "time_series_metric": "gauge",
                                    "meta": {},
                                    "type": "long"
                                  }
                                }
                              }
                            }
                          },
                          "egress": {
                            "properties": {
                              "bytes": {
                                "time_series_metric": "gauge",
                                "meta": {},
                                "type": "long"
                              },
                              "packets": {
                                "properties": {
                                  "count": {
                                    "time_series_metric": "gauge",
                                    "meta": {},
                                    "type": "long"
                                  }
                                }
                              }
                            }
                          }
                        }
                      },
                      "uptime": {
                        "properties": {
                          "sec": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  },
                  "firewall": {
                    "properties": {
                      "dropped": {
                        "properties": {
                          "bytes": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      },
                      "dropped_packets_count": {
                        "properties": {
                          "value": {
                            "time_series_metric": "gauge",
                            "meta": {},
                            "type": "long"
                          }
                        }
                      }
                    }
                  }
                }
              },
              "labels_fingerprint": {
                "time_series_dimension": true,
                "type": "keyword"
              },
              "metrics": {
                "dynamic": true,
                "type": "object"
              },
              "labels": {
                "dynamic": true,
                "type": "object",
                "properties": {
                  "metadata": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "system": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "resource": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "metrics": {
                    "dynamic": true,
                    "type": "object"
                  },
                  "user": {
                    "dynamic": true,
                    "type": "object"
                  }
                }
              }
            }
          },
          "data_stream": {
            "properties": {
              "namespace": {
                "type": "constant_keyword"
              },
              "type": {
                "type": "constant_keyword"
              },
              "dataset": {
                "type": "constant_keyword"
              }
            }
          },
          "host": {
            "properties": {
              "os": {
                "properties": {
                  "build": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  },
                  "codename": {
                    "ignore_above": 1024,
                    "type": "keyword"
                  }
                }
              },
              "containerized": {
                "type": "boolean"
              }
            }
          },
          "event": {
            "properties": {
              "module": {
                "type": "constant_keyword",
                "value": "gcp"
              },
              "dataset": {
                "type": "constant_keyword",
                "value": "gcp.compute"
              }
            }
          }
        }
      }
    },
    "_meta": {
      "package": {
        "name": "gcp"
      },
      "managed_by": "fleet",
      "managed": true
    }
  }
}
