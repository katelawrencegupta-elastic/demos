{
  "name": ".alerts-ml.anomaly-detection-health.alerts-mappings",
  "component_template": {
    "template": {
      "settings": {},
      "mappings": {
        "dynamic": "strict",
        "properties": {
          "kibana": {
            "properties": {
              "alert": {
                "properties": {
                  "delayed_data_results": {
                    "dynamic": false,
                    "type": "object",
                    "properties": {
                      "annotation": {
                        "type": "text"
                      },
                      "missed_docs_count": {
                        "type": "long"
                      },
                      "end_timestamp": {
                        "type": "date"
                      },
                      "job_id": {
                        "type": "keyword"
                      }
                    }
                  },
                  "job_errors_results": {
                    "dynamic": false,
                    "type": "object",
                    "properties": {
                      "job_id": {
                        "type": "keyword"
                      },
                      "errors": {
                        "type": "object"
                      }
                    }
                  },
                  "datafeed_results": {
                    "dynamic": false,
                    "type": "object",
                    "properties": {
                      "datafeed_id": {
                        "type": "keyword"
                      },
                      "datafeed_state": {
                        "type": "keyword"
                      },
                      "job_id": {
                        "type": "keyword"
                      },
                      "job_state": {
                        "type": "keyword"
                      }
                    }
                  },
                  "mml_results": {
                    "dynamic": false,
                    "type": "object",
                    "properties": {
                      "model_bytes": {
                        "type": "long"
                      },
                      "model_bytes_memory_limit": {
                        "type": "long"
                      },
                      "peak_model_bytes": {
                        "type": "long"
                      },
                      "job_id": {
                        "type": "keyword"
                      },
                      "memory_status": {
                        "type": "keyword"
                      },
                      "log_time": {
                        "type": "date"
                      },
                      "model_bytes_exceeded": {
                        "type": "long"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "_meta": {
      "managed": true
    }
  }
}
