{
  "name": "metrics-otel@template",
  "index_template": {
    "index_patterns": [
      "metrics-*.otel-*"
    ],
    "template": {
      "settings": {
        "index": {
          "mode": "time_series"
        }
      },
      "mappings": {
        "properties": {
          "data_stream.type": {
            "type": "constant_keyword",
            "value": "metrics"
          }
        }
      }
    },
    "composed_of": [
      "metrics@tsdb-settings",
      "otel@mappings",
      "otel@settings",
      "metrics-otel@mappings",
      "semconv-resource-to-ecs@mappings",
      "metrics@custom",
      "metrics-otel@custom",
      "ecs-tsdb@mappings"
    ],
    "priority": 120,
    "version": 20,
    "_meta": {
      "description": "default OpenTelemetry metrics template installed by x-pack",
      "managed": true
    },
    "data_stream": {
      "hidden": false,
      "allow_custom_routing": false
    },
    "allow_auto_create": true,
    "ignore_missing_component_templates": [
      "metrics@custom",
      "metrics-otel@custom"
    ],
    "created_date_millis": 1786555715950,
    "modified_date_millis": 1787594297889
  }
}
