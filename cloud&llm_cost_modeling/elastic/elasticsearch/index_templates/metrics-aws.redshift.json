{
  "name": "metrics-aws.redshift",
  "index_template": {
    "index_patterns": [
      "metrics-aws.redshift-*"
    ],
    "template": {
      "settings": {
        "index": {
          "mode": "time_series"
        }
      },
      "mappings": {
        "_meta": {
          "package": {
            "name": "aws"
          },
          "managed_by": "fleet",
          "managed": true
        }
      }
    },
    "composed_of": [
      "metrics@tsdb-settings",
      "metrics-aws.redshift@package",
      "metrics@custom",
      "aws@custom",
      "metrics-aws.redshift@custom",
      "ecs@mappings",
      ".fleet_globals-1",
      ".fleet_event_ingested-1"
    ],
    "priority": 200,
    "_meta": {
      "package": {
        "name": "aws"
      },
      "managed_by": "fleet",
      "managed": true
    },
    "data_stream": {
      "hidden": false,
      "allow_custom_routing": false
    },
    "ignore_missing_component_templates": [
      "metrics@custom",
      "aws@custom",
      "metrics-aws.redshift@custom"
    ],
    "created_date_millis": 1786557381404,
    "modified_date_millis": 1786557381404
  }
}
