{
  "name": "logs-system.syslog-2.22.3-log",
  "on_failure": [
    {
      "set": {
        "field": "error.message",
        "value": "Processor '{{{ _ingest.on_failure_processor_type }}}' {{{#_ingest.on_failure_processor_tag}}}with tag '{{{ _ingest.on_failure_processor_tag }}}' {{{/_ingest.on_failure_processor_tag}}}failed with message '{{{ _ingest.on_failure_message }}}'"
      }
    }
  ],
  "modified_date_millis": 1786558591740,
  "description": "Pipeline for parsing Syslog messages.",
  "_meta": {
    "package": {
      "name": "system"
    },
    "managed_by": "fleet",
    "managed": true
  },
  "created_date_millis": 1786558591740,
  "processors": [
    {
      "remove": {
