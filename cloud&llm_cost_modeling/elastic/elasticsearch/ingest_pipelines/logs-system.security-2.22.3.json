      }
    },
    {
      "pipeline": {
        "name": "logs-system.security-2.22.3-scheduled_task",
        "if": "ctx.winlog != null && ctx.winlog.provider_name == 'Microsoft-Windows-Security-Auditing' && ctx.event != null && ctx.winlog._tmp?.scheduled_task instanceof Map && (\n  (\n    ['4698', '4699', '4700', '4701'].contains(ctx.event.code) &&\n    ctx.winlog._tmp.scheduled_task.task_content instanceof Map\n  ) ||\n  (\n    ctx.event.code == '4702' &&\n    ctx.winlog._tmp.scheduled_task.task_content_new instanceof Map\n  )\n)"
