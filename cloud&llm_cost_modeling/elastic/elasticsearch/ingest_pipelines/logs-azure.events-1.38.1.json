        "ignore_missing_pipeline": true,
        "description": "[Fleet] Pipeline for all data streams of type `logs` defined by the `azure` integration"
      }
    },
    {
      "pipeline": {
        "name": "logs-azure.events@custom",
        "ignore_missing_pipeline": true,
        "description": "[Fleet] Pipeline for the `azure.events` dataset"
      }
    },
