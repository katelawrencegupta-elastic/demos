{
  "name": "logs-azure.identity_protection-1.38.1-azure-shared-pipeline",
  "on_failure": [
    {
      "set": {
        "field": "event.kind",
        "value": "pipeline_error"
      }
    },
    {
      "append": {
        "field": "tags",
        "allow_duplicates": false,
        "value": "preserve_original_event"
      }
    },
    {
      "append": {
        "field": "error.message",
        "value": "Processor '{{{ _ingest.on_failure_processor_type }}}' {{#_ingest.on_failure_processor_tag}}with tag '{{{ _ingest.on_failure_processor_tag }}}' {{/_ingest.on_failure_processor_tag}}failed with message '{{{ _ingest.on_failure_message }}}'"
      }
    }
  ],
  "modified_date_millis": 1786557407463,
  "description": "Pipeline for parsing Azure shared log fields.",
  "_meta": {
    "package": {
      "name": "azure"
    },
    "managed_by": "fleet",
    "managed": true
  },
  "created_date_millis": 1786557407463,
  "processors": [
    {
      "set": {
        "field": "cloud.provider",
        "value": "azure"
      }
    },
    {
      "grok": {
        "ignore_failure": true,
        "field": "azure.resource_id",
        "pattern_definitions": {
          "PROVIDERNAME": ".+",
          "TENANTID": "(\\{){0,1}[0-9a-fA-F]{8}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{4}\\-[0-9a-fA-F]{12}(\\}){0,1}"
        },
        "patterns": [
          "/TENANTS/%{TENANTID:azure.tenant_id}/PROVIDERS/%{PROVIDERNAME:azure.resource.provider}",
          "/tenants/%{TENANTID:azure.tenant_id}/providers/%{PROVIDERNAME:azure.resource.provider}"
