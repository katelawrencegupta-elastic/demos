      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "field": "azure.resource_id",
        "target_field": "azure.resource.id"
      }
    },
    {
      "lowercase": {
        "field": "event.outcome",
        "ignore_missing": true
      }
    }
  ]
}
