{
  "name": "metrics-anthropic_metrics.usage-0.4.0",
  "on_failure": [
    {
      "append": {
        "field": "error.message",
        "value": "Processor '{{{ _ingest.on_failure_processor_type }}}' {{{#_ingest.on_failure_processor_tag}}}with tag '{{{ _ingest.on_failure_processor_tag }}}' {{{/_ingest.on_failure_processor_tag}}}failed with message '{{{ _ingest.on_failure_message }}}'"
      }
    },
    {
      "set": {
        "tag": "set_pipeline_error_to_event_kind",
        "field": "event.kind",
        "value": "pipeline_error"
      }
    },
    {
      "append": {
        "field": "tags",
        "allow_duplicates": false,
        "value": "preserve_original_event"
      }
    }
  ],
  "modified_date_millis": 1786643480265,
  "description": "Pipeline for parsing Anthropic message usage report events.",
  "_meta": {
    "package": {
      "name": "anthropic_metrics"
    },
    "managed_by": "fleet",
    "managed": true
  },
  "created_date_millis": 1786643480265,
  "processors": [
    {
      "set": {
        "tag": "set_ecs_version",
        "field": "ecs.version",
        "value": "9.3.0"
      }
    },
    {
      "remove": {
        "ignore_missing": true,
        "description": "Removes the fields added by Agentless as metadata, as they can collide with ECS fields.",
        "tag": "remove_agentless_tags",
        "field": [
          "organization",
          "division",
          "team"
        ],
        "if": "ctx.organization instanceof String && ctx.division instanceof String && ctx.team instanceof String"
      }
    },
    {
      "terminate": {
        "description": "error message set and no data to process.",
        "tag": "data_collection_error",
        "if": "ctx.error?.message != null && ctx.message == null && ctx.event?.original == null"
      }
    },
    {
      "rename": {
        "field": "message",
        "target_field": "event.original",
        "ignore_missing": true,
        "description": "Renames the original `message` field to `event.original` to store a copy of the original message. The `event.original` field is not touched if the document already has one; it may happen when Logstash sends the document.",
        "tag": "rename_message_to_event_original",
        "if": "ctx.event?.original == null"
      }
    },
    {
      "remove": {
        "ignore_missing": true,
        "description": "The `message` field is no longer required if the document has an `event.original` field.",
        "tag": "remove_message",
        "field": "message",
        "if": "ctx.event?.original != null"
      }
    },
    {
      "json": {
        "tag": "parse_json",
        "field": "event.original",
        "target_field": "json",
        "if": "ctx.event?.original != null"
      }
    },
    {
      "script": {
        "tag": "remove_null_fields",
        "source": "if (ctx.json.containsKey('workspace_id') && ctx.json.workspace_id == null) {\n  ctx.json.workspace_id = 'Default';\n} ctx.json.entrySet().removeIf(e -> e.getValue() == null);",
        "lang": "painless",
        "if": "ctx.json != null"
      }
    },
    {
      "date": {
        "formats": [
          "ISO8601"
        ],
        "tag": "date_bucket_start_time_to_timestamp",
        "field": "json.bucket_start_time",
        "target_field": "@timestamp",
        "if": "ctx.json?.bucket_start_time != null"
      }
    },
    {
      "date": {
        "formats": [
          "ISO8601"
        ],
        "tag": "date_bucket_start_time",
        "field": "json.bucket_start_time",
        "target_field": "anthropic.usage.bucket_start_time",
        "if": "ctx.json?.bucket_start_time != null"
      }
    },
    {
      "date": {
        "formats": [
          "ISO8601"
        ],
        "tag": "date_bucket_end_time",
        "field": "json.bucket_end_time",
        "target_field": "anthropic.usage.bucket_end_time",
        "if": "ctx.json?.bucket_end_time != null"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_model",
        "field": "json.model",
        "target_field": "anthropic.usage.model"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_workspace_id",
        "field": "json.workspace_id",
        "target_field": "anthropic.usage.workspace_id"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_api_key_id",
        "field": "json.api_key_id",
        "target_field": "anthropic.usage.api_key_id"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_service_tier",
        "field": "json.service_tier",
        "target_field": "anthropic.usage.service_tier"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_context_window",
        "field": "json.context_window",
        "target_field": "anthropic.usage.context_window"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_inference_geo",
        "field": "json.inference_geo",
        "target_field": "anthropic.usage.inference_geo"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_speed",
        "field": "json.speed",
        "target_field": "anthropic.usage.speed"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_uncached_input_tokens",
        "field": "json.uncached_input_tokens",
        "target_field": "anthropic.usage.uncached_input_tokens"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_cache_read_input_tokens",
        "field": "json.cache_read_input_tokens",
        "target_field": "anthropic.usage.cached_input_tokens"
      }
    },
    {
      "script": {
        "tag": "sum_cache_creation_tokens",
        "source": "long total = 0; if (ctx.json.cache_creation.containsKey('ephemeral_5m_input_tokens')) {\n  total += ctx.json.cache_creation.ephemeral_5m_input_tokens;\n} if (ctx.json.cache_creation.containsKey('ephemeral_1h_input_tokens')) {\n  total += ctx.json.cache_creation.ephemeral_1h_input_tokens;\n} ctx.anthropic = ctx.anthropic != null ? ctx.anthropic : new HashMap(); ctx.anthropic.usage = ctx.anthropic.usage != null ? ctx.anthropic.usage : new HashMap(); ctx.anthropic.usage.cache_creation_input_tokens = total;",
        "lang": "painless",
        "if": "ctx.json?.cache_creation != null"
      }
    },
    {
      "rename": {
        "ignore_missing": true,
        "tag": "rename_output_tokens",
        "field": "json.output_tokens",
        "target_field": "anthropic.usage.output_tokens"
      }
    },
    {
      "set": {
        "tag": "set_event_kind",
        "field": "event.kind",
        "value": "event"
      }
    },
    {
      "append": {
        "tag": "append_event_category_api",
        "field": "event.category",
        "value": "api"
      }
    },
    {
      "append": {
        "tag": "append_event_type_info",
        "field": "event.type",
        "value": "info"
      }
    },
    {
      "remove": {
        "ignore_missing": true,
        "tag": "remove_json",
        "field": "json"
      }
    },
    {
      "append": {
        "tag": "append_preserve_original_event_tag",
        "field": "tags",
        "allow_duplicates": false,
        "value": "preserve_original_event",
        "if": "ctx.error?.message != null"
      }
    },
    {
      "pipeline": {
        "name": "global@custom",
        "ignore_missing_pipeline": true,
        "description": "[Fleet] Global pipeline for all data streams"
      }
    },
    {
      "pipeline": {
        "name": "metrics@custom",
        "ignore_missing_pipeline": true,
        "description": "[Fleet] Pipeline for all data streams of type `metrics`"
      }
    },
    {
      "pipeline": {
        "name": "metrics-anthropic_metrics.integration@custom",
        "ignore_missing_pipeline": true,
        "description": "[Fleet] Pipeline for all data streams of type `metrics` defined by the `anthropic_metrics` integration"
      }
    },
    {
      "pipeline": {
        "name": "metrics-anthropic_metrics.usage@custom",
        "ignore_missing_pipeline": true,
        "description": "[Fleet] Pipeline for the `anthropic_metrics.usage` dataset"
      }
    }
  ]
}
