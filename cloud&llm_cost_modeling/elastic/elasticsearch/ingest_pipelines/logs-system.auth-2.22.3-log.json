{
  "name": "logs-system.auth-2.22.3-log",
  "on_failure": [
    {
      "set": {
        "field": "event.kind",
        "value": "pipeline_error"
      }
    },
    {
      "set": {
        "field": "error.message",
        "value": "Processor '{{{ _ingest.on_failure_processor_type }}}' {{{#_ingest.on_failure_processor_tag}}}with tag '{{{ _ingest.on_failure_processor_tag }}}' {{{/_ingest.on_failure_processor_tag}}}failed with message '{{{ _ingest.on_failure_message }}}'"
      }
    }
  ],
  "modified_date_millis": 1786558591741,
  "description": "Pipeline for parsing system authorization and secure logs.",
  "_meta": {
    "package": {
      "name": "system"
    },
    "managed_by": "fleet",
    "managed": true
  },
  "created_date_millis": 1786558591741,
  "processors": [
    {
      "grok": {
        "field": "event.original",
        "patterns": [
          "^<%{NONNEGINT:log.syslog.priority:int}>(?:%{NONNEGINT:system.auth.syslog.version} )?+(?:-|%{TIMESTAMP:system.auth.timestamp}) +(?:-|%{IPORHOST:host.hostname}) +(?:-|%{SYSLOG5424PRINTASCII:process.name}) +(?:-|%{POSINT:process.pid:long}) +(?:-|%{SYSLOG5424PRINTASCII:event.code}) +(?:-|%{SYSLOG5424SD:syslog5424_sd})? +%{GREEDYDATA:message}$",
          "^%{TIMESTAMP:system.auth.timestamp} %{SYSLOGHOST:host.hostname}? %{DATA:process.name}(?:\\[%{POSINT:process.pid:long}\\])?:%{SPACE}%{GREEDYMULTILINE:message}$",
          "^<%{NONNEGINT:log.syslog.priority:int}>(?:%{NONNEGINT:system.auth.syslog.version} )?%{TIMESTAMP:system.auth.timestamp} %{SYSLOGHOST:host.hostname}? %{DATA:process.name}(?:\\[%{POSINT:process.pid:long}\\])?:%{SPACE}%{GREEDYMULTILINE:message}$"
        ],
        "description": "Grok the message header when Beats syslog processor did not.",
        "tag": "grok-message-header",
        "pattern_definitions": {
          "GREEDYMULTILINE": "(.|\\n)*",
          "TIMESTAMP": "(?:%{TIMESTAMP_ISO8601}|%{SYSLOGTIMESTAMP})"
        },
        "if": "ctx.log?.syslog == null"
      }
    },
    {
      "pipeline": {
        "name": "logs-system.auth-2.22.3-message"
      }
    }
  ]
}
