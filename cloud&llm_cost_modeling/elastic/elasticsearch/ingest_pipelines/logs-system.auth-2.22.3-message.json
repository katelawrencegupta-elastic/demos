        "description": "Grok specific auth messages.",
        "ignore_missing": true,
        "tag": "grok-specific-messages"
      }
    },
    {
      "set": {
        "ignore_empty_value": true,
        "field": "user.name",
        "description": "Deprecated duplication of user.target.name for backward compatibility; will be removed for useradd events in a future major version.",
        "tag": "set_user_name_useradd_compat",
        "copy_from": "user.target.name",
        "if": "ctx.user?.target?.name != null"
      }
    },
    {
      "set": {
        "ignore_empty_value": true,
        "field": "user.id",
        "description": "Deprecated duplication of user.target.id for backward compatibility; will be removed for useradd events in a future major version.",
