    "package": {
      "name": "system"
    },
    "managed_by": "fleet",
    "managed": true
  },
  "created_date_millis": 1786558591743,
  "processors": [
    {
      "grok": {
        "ignore_failure": true,
        "field": "message",
        "patterns": [
