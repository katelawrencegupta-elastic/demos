{
  "id": "logs-aws.latest_cdr_misconfigurations-default-0.4.0",
  "authorization": {
    "service_account": "elastic/kibana"
  },
  "version": "10.0.0",
  "create_time": 1786557384662,
  "source": {
    "index": [
      "logs-aws.securityhub_findings_full_posture-*"
    ],
    "query": {
      "bool": {
        "must": [
          {
            "range": {
              "@timestamp": {
                "gte": "now-26h"
              }
            }
          }
        ],
        "must_not": [
          {
            "exists": {
              "field": "error.message"
            }
          },
          {
            "terms": {
              "_tier": [
                "data_frozen",
                "data_cold"
              ]
            }
          }
        ]
      }
    }
  },
  "dest": {
    "index": "security_solution-aws.misconfiguration_latest-v3",
    "aliases": [
      {
        "alias": "security_solution-aws.misconfiguration_latest",
        "move_on_creation": true
      }
    ]
  },
  "frequency": "5m",
  "sync": {
    "time": {
      "field": "event.ingested",
      "delay": "60s"
    }
  },
  "latest": {
    "unique_key": [
      "rule.id",
      "resource.id",
      "data_stream.namespace"
    ],
    "sort": "@timestamp"
  },
  "description": "Latest Security Hub CSPM Findings from AWS.",
  "settings": {
    "unattended": true
  },
  "_meta": {
    "managed": true,
    "fleet_transform_version": "0.4.0",
    "managed_by": "fleet",
    "package": {
      "name": "aws"
    },
    "installed_by": "719348788",
    "run_as_kibana_system": true
  },
  "retention_policy": {
    "time": {
      "field": "@timestamp",
      "max_age": "26h"
    }
  }
}
