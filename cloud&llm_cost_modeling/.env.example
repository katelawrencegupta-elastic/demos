# Named Elastic Cloud deployments — keep many targets in one file.
# Select with FINOPS_DEPLOYMENT=<name> or: python -m src.cli --deployment <name> …
#
# Each block uses DEPLOY_<NAME>_<KEY>. NAME is case-insensitive (gcp, GCP, Gcp).
# Keys: ELASTIC_URL, ELASTIC_API_KEY, KIBANA_URL, KIBANA_SPACE,
#       FINOPS_PROFILE (synthetic|live), VARIANT (workshop id from config/variants.yaml)
#
# List:  python -m src.cli deployments

FINOPS_DEPLOYMENT=gcp

# ─── example: gcp ────────────────────────────────────────────────────────────
DEPLOY_GCP_ELASTIC_URL=https://YOUR_PROJECT.es.REGION.gcp.elastic.cloud:443
DEPLOY_GCP_ELASTIC_API_KEY=
DEPLOY_GCP_KIBANA_URL=https://YOUR_PROJECT.kb.REGION.gcp.elastic.cloud
DEPLOY_GCP_KIBANA_SPACE=finops
DEPLOY_GCP_FINOPS_PROFILE=synthetic
DEPLOY_GCP_VARIANT=gcp

# ─── example: azure ──────────────────────────────────────────────────────────
# DEPLOY_AZURE_ELASTIC_URL=https://YOUR_PROJECT.es.REGION.azure.elastic.cloud:443
# DEPLOY_AZURE_ELASTIC_API_KEY=
# DEPLOY_AZURE_KIBANA_URL=https://YOUR_PROJECT.kb.REGION.azure.elastic.cloud
# DEPLOY_AZURE_KIBANA_SPACE=finops
# DEPLOY_AZURE_FINOPS_PROFILE=synthetic
# DEPLOY_AZURE_VARIANT=azure

# ─── example: aws ────────────────────────────────────────────────────────────
# DEPLOY_AWS_ELASTIC_URL=https://YOUR_PROJECT.es.REGION.aws.elastic.cloud:443
# DEPLOY_AWS_ELASTIC_API_KEY=
# DEPLOY_AWS_KIBANA_URL=https://YOUR_PROJECT.kb.REGION.aws.elastic.cloud
# DEPLOY_AWS_KIBANA_SPACE=finops
# DEPLOY_AWS_FINOPS_PROFILE=live
# DEPLOY_AWS_VARIANT=aws

# ─── single-target fallback (no FINOPS_DEPLOYMENT) ───────────────────────────
# Still supported if you only need one cluster:
# ELASTIC_URL=https://YOUR_PROJECT.es.REGION.gcp.elastic.cloud:443
# ELASTIC_API_KEY=
# KIBANA_URL=https://YOUR_PROJECT.kb.REGION.gcp.elastic.cloud
# KIBANA_SPACE=
# FINOPS_PROFILE=synthetic
