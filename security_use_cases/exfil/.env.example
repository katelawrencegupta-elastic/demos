# Elastic Cloud (for enable-exfil-rules.py)
# Copy from logstash/.env or set your deployment values here.
ELASTIC_HOSTS=https://your-deployment.es.io:443
ELASTIC_API_KEY=your_id:your_api_key
# Superuser key required to install/enable detection rules (Kibana → Stack Management → API keys)
ELASTIC_ADMIN_API_KEY=your_id:your_admin_api_key

# all | flow | netflow | snort | process
# "all" emits flow/netflow/snort plus synthetic endpoint process events for curl and wget.
# EXFIL_TOOLS=curl,wget
EXFIL_OUTPUT_MODE=all
# Use container name when logstash runs on the shared `demos` docker network.
EXFIL_SYSLOG_TARGET=logstash
EXFIL_SYSLOG_PORT=514
EXFIL_NETFLOW_TARGET=logstash
EXFIL_NETFLOW_PORT=2055
EXFIL_RECEIVER_URL=http://127.0.0.1:8888/upload
EXFIL_INTERVAL=15
EXFIL_JITTER=0.2
EXFIL_SNORT_FORMAT=fast
EXFIL_HOSTNAME=exfil-demo
EXFIL_ALERT_PROBABILITY=0.4
EXFIL_HOSTS=2
EXFIL_IMAGE=demos-exfil
EXFIL_CONTAINER_NAME=exfil-generator
