FROM python:3.12-slim

WORKDIR /app

COPY generate.py /app/generate.py

ENV BEACON_OUTPUT_MODE=all
ENV BEACON_SYSLOG_TARGET=172.17.0.2
ENV BEACON_SYSLOG_PORT=514
ENV BEACON_NETFLOW_TARGET=172.17.0.2
ENV BEACON_NETFLOW_PORT=2055
ENV BEACON_HOSTS=3
ENV BEACON_C2_COUNT=2
ENV BEACON_INTERVALS=60,120,300
ENV BEACON_JITTER=0.05
ENV BEACON_SNORT_FORMAT=fast
ENV BEACON_HOSTNAME=beacon-demo
ENV BEACON_TICK=0.5
ENV BEACON_ALERT_PROBABILITY=0.35

CMD ["python", "-u", "/app/generate.py"]
