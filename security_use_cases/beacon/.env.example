# Elastic Cloud (for enable-*-rules.py and trigger-beacon-transform.py)
# Copy from logstash/.env or set your deployment values here.
ELASTIC_HOSTS=https://your-deployment.es.io:443
ELASTIC_API_KEY=your_id:your_api_key
# Superuser key required to install/enable detection rules (Kibana → Stack Management → API keys)
ELASTIC_ADMIN_API_KEY=your_id:your_admin_api_key

BEACON_OUTPUT_MODE=all
# Use container name when logstash runs on the shared `demos` docker network.
BEACON_SYSLOG_TARGET=logstash
BEACON_SYSLOG_PORT=514
BEACON_NETFLOW_TARGET=logstash
BEACON_NETFLOW_PORT=2055
BEACON_HOSTS=3
BEACON_C2_COUNT=2
BEACON_INTERVALS=60,120,300
BEACON_JITTER=0.05
BEACON_SNORT_FORMAT=fast
BEACON_HOSTNAME=beacon-demo
BEACON_TICK=0.5
BEACON_ALERT_PROBABILITY=0.35
# Hours of historical flow events to backfill on startup for the ML beaconing transform.
BEACON_BACKFILL_HOURS=6
BEACON_IMAGE=demos-beacon
BEACON_CONTAINER_NAME=beacon-generator
