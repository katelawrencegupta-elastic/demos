# Elastic Cloud (for enable-dga-rules.py)
# Copy from logstash/.env or set your deployment values here.
ELASTIC_HOSTS=https://your-deployment.es.io:443
ELASTIC_API_KEY=your_id:your_api_key
# Superuser key required to install/enable detection rules (Kibana → Stack Management → API keys)
ELASTIC_ADMIN_API_KEY=your_id:your_admin_api_key

DGA_OUTPUT_MODE=all
# host.docker.internal reaches Logstash on the Docker host (Mac/Windows).
# On Linux with Logstash on the default bridge, use the Logstash container IP instead.
# Use container name when logstash runs on the shared `demos` docker network.
DGA_SYSLOG_TARGET=logstash
DGA_NETFLOW_TARGET=logstash
DGA_SYSLOG_PORT=514
DGA_NETFLOW_PORT=2055
DGA_INTERVAL=3
DGA_QUERIES_PER_BURST=3
DGA_RATIO=0.7
DGA_NXDOMAIN_RATIO=0.92
DGA_SNORT_FORMAT=fast
DGA_HOSTNAME=dga-demo
DGA_INFECTED_HOSTS=3
# Optional: pin a single algorithm (random, consonant_vowel, wordlist, time_seeded, hex_seed)
# DGA_ALGORITHM=random
DGA_IMAGE=demos-dga
DGA_CONTAINER_NAME=dga-generator
