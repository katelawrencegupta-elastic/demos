FROM python:3.12-slim

WORKDIR /app

COPY dga.py generate.py /app/

ENV DGA_OUTPUT_MODE=all
ENV DGA_SYSLOG_TARGET=host.docker.internal
ENV DGA_SYSLOG_PORT=514
ENV DGA_NETFLOW_TARGET=host.docker.internal
ENV DGA_NETFLOW_PORT=2055
ENV DGA_INTERVAL=3
ENV DGA_QUERIES_PER_BURST=3
ENV DGA_RATIO=0.7
ENV DGA_NXDOMAIN_RATIO=0.92
ENV DGA_SNORT_FORMAT=fast
ENV DGA_HOSTNAME=dga-demo
ENV DGA_INFECTED_HOSTS=3

CMD ["python", "-u", "/app/generate.py"]
